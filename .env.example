# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SMTP & Report Email Configuration (Environment-variable-backed storage)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USERNAME="ops@example.com"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM_NAME="RESQ-MIND Tactical Command"
SMTP_FROM_EMAIL="alerts@resq-mind.gov"
REPORT_EMAIL_TO="incident.commander@disaster.gov"

# Communication & Webhook Settings
COMM_BROADCAST_CHANNEL="VHF_CH9_AND_SATELLITE"
COMM_AUTO_DISPATCH_CRITICAL="true"
COMM_WEBHOOK_URL="https://emergency-dispatch.local/webhook"
COMM_WEBHOOK_SECRET="your_webhook_secret_here"
COMM_RETRY_LIMIT="3"
COMM_TIMEOUT_SECONDS="15"
COMM_QUIET_HOURS="false"
COMM_LOG_LEVEL="INFO"
